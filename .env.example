# ====================
# General
# ====================
NODE_ENV=development

# ====================
# Database
# ====================
DB_TYPE=sqlite  # Opciones: sqlite, postgres
DB_USER=parcial_user
DB_PASSWORD=secure_password_here
DB_NAME=parcial_electiva_db
DB_HOST=db
DB_PORT=5432

# ====================
# Backend
# ====================
BACKEND_PORT=3000
JWT_SECRET=your_secure_jwt_secret_key_here_change_in_production

# ====================
# Frontend
# ====================
FRONTEND_PORT=80
VITE_API_URL=http://localhost:3000

# ====================
# CORS
# ====================
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost:3000
