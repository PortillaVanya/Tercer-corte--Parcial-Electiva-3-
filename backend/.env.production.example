# Configuración del Servidor
PORT=8080
NODE_ENV=production

# Configuración de Base de Datos (MySQL/MariaDB)
DB_HOST=db
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
DB_DATABASE=tienda_virtual

# Seguridad
# IMPORTANTE: Cambia JWT_SECRET a un valor aleatorio seguro de 32+ caracteres
# Genera uno con: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_32_CHARS_MIN
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# CORS
# Cambia esto a tu dominio real en producción
CORS_ORIGIN=https://tu-dominio.com

# SMTP para Emails (Nodemailer)
# IMPORTANTE: Para Gmail, usa una "App Password" en lugar de tu contraseña normal
# 1. Ve a https://myaccount.google.com/security
# 2. Activa "Verificación en dos pasos"
# 3. Ve a "Contraseñas de aplicaciones"
# 4. Crea una nueva app password y úsala aquí
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM=noreply@tu-dominio.com
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PHONE=573001112233

# Redis para Caché y Colas
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Slack Webhook para Notificaciones
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# WhatsApp API para Notificaciones
WHATSAPP_API_URL=https://graph.facebook.com/v17.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
