# Configuración del Servidor
PORT=8080
NODE_ENV=development

# Configuración de Base de Datos (MySQL/MariaDB)
# Usar 127.0.0.1 para evitar problemas con IPv6 en Windows
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=tienda_virtual

# Seguridad
# IMPORTANT: Change JWT_SECRET to a strong random value in production (min 32 chars)
JWT_SECRET=
# For docker-compose
MYSQL_ROOT_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP para Emails (Nodemailer)
# IMPORTANTE: Para Gmail, usa una "App Password" en lugar de tu contraseña normal
# 1. Ve a https://myaccount.google.com/security
# 2. Activa "Verificación en dos pasos"
# 3. Ve a "Contraseñas de aplicaciones"
# 4. Crea una nueva app password y úsala aquí
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM=noreply@inventario.com
ADMIN_EMAIL=admin@inventario.com
ADMIN_PHONE=573001112233

# Redis para Caché y Colas
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Slack Webhook para Notificaciones
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# WhatsApp API para Notificaciones
WHATSAPP_API_URL=https://graph.facebook.com/v17.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
